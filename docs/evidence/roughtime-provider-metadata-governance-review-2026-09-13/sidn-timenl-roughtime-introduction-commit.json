_admin":false},"parents":[{"sha":"9b7f258838c92cf6d2409eeee016b86fa41134b9","url":"https://api.github.com/repos/SIDN/TimeNL/commits/9b7f258838c92cf6d2409eeee016b86fa41134b9","html_url":"https://github.com/SIDN/TimeNL/commit/9b7f258838c92cf6d2409eeee016b86fa41134b9"}],"stats":{"total":52,"additions":50,"deletions":2},"files":[{"sha":"3a9d6d47260df38090ab8e0b4abce96b73012fb5","filename":"index.html","status":"modified","additions":23,"deletions":1,"changes":24,"blob_url":"https://github.com/SIDN/TimeNL/blob/462312aec160c3ab34db92a2003aebe4eba86ed1/index.html","raw_url":"https://github.com/SIDN/TimeNL/raw/462312aec160c3ab34db92a2003aebe4eba86ed1/index.html","contents_url":"https://api.github.com/repos/SIDN/TimeNL/contents/index.html?ref=462312aec160c3ab34db92a2003aebe4eba86ed1","patch":"@@ -332,7 +332,29 @@ <h3><a id=\"FAQ\"></a>Veelgestelde vragen</h3>\n           <button class=\"btn btn-info\" type=\"button\" data-toggle=\"collapse\" data-target=\"#roughtime\"><strong>Vraag:</strong> Is er ondersteuning voor Roughtime?</button>\n           <div id=\"roughtime\" class=\"collapse\">\n             <div class=\"alert alert-dark\">\n-              <p class=\"text-justify\"><strong>Antwoord:</strong> Nee, <a href=\"https://datatracker.ietf.org/doc/html/draft-ietf-ntp-roughtime\">roughtime</a>' ondersteunen we nog niet. </p>\n+              <p class=\"text-justify\"><strong>Antwoord:</strong> Ja, <a href=\"https://datatracker.ietf.org/doc/html/draft-ietf-ntp-roughtime\">roughtime</a>' ondersteunen we op rough.time.nl:2002 als een pilot. Dit protocol is nog in ontwikkeling en er kunnen nog zaken veranderen, zoals het poortnummer. Hou daarom deze site in de gaten. Voeg dit toe aan je server list:\n+              <br>\n+<div class=\"codeclass\">\n+<pre>\n+{\n+  \"servers\": [\n+    {\n+      \"name\": \"TimeNL-Roughtime\",\n+      \"publicKey\": \"v2CievhgKsxzlWPwIkYFUXeA51Akhkv5uhJCj1/kbiY=\",\n+      \"addresses\": [\n+        {\n+          \"protocol\": \"udp\",\n+          \"address\": \"rough.time.nl:2002\"\n+        }\n+      ]\n+    }\n+  ]\n+}\n+</pre>\n+</div>\n+<br>\n+Maar zorg ervoor dat je minimaal 2 andere Roughtime servers daaraan hebt toegevoegd! Overweeg ook om lettelijk de IPv4 en/of IPv6-adressen van onze server te gebruiken, i.p.v. de FQDN, om DNSSEC-bootstrap problemen te voorkomen.\n+</p>\n             </div>\n           </div>\n           <br><br>          "},{"sha":"2935826d2b351f61c0aee7ff857e61dc44be6ca9","filename":"index_en.html","status":"modified","additions":23,"deletions":1,"changes":24,"blob_url":"https://github.com/SIDN/TimeNL/blob/462312aec160c3ab34db92a2003aebe4eba86ed1/index_en.html","raw_url":"https://github.com/SIDN/TimeNL/raw/462312aec160c3ab34db92a2003aebe4eba86ed1/index_en.html","contents_url":"https://api.github.com/repos/SIDN/TimeNL/contents/index_en.html?ref=462312aec160c3ab34db92a2003aebe4eba86ed1","patch":"@@ -330,7 +330,29 @@ <h3><a id=\"FAQ\"></a>FAQs</h3>\n           <button class=\"btn btn-info\" type=\"button\" data-toggle=\"collapse\" data-target=\"#roughtime\"><strong>Question:</strong> Do you offer support for Roughtime?</button>\n           <div id=\"roughtime\" class=\"collapse\">\n             <div class=\"alert alert-dark\">\n-              <p class=\"text-justify\"><strong>Answer:</strong> No, there is no support for '<a href=\"https://datatracker.ietf.org/doc/html/draft-ietf-ntp-roughtime\">roughtime</a>' just yet.</p>\n+              <p class=\"text-justify\"><strong>Antwoord:</strong> Yes, we support <a href=\"https://datatracker.ietf.org/doc/html/draft-ietf-ntp-roughtime\">roughtime</a>' as a pilot program at rough.time.nl:2002. This protocol is still under development, and things like the port number may change. So keep an eye on this site. Add this to your server list:\n+              <br>\n+<div class=\"codeclass\">\n+<pre>\n+{\n+  \"servers\": [\n+    {\n+      \"name\": \"TimeNL-Roughtime\",\n+      \"publicKey\": \"v2CievhgKsxzlWPwIkYFUXeA51Akhkv5uhJCj1/kbiY=\",\n+      \"addresses\": [\n+        {\n+          \"protocol\": \"udp\",\n+          \"address\": \"rough.time.nl:2002\"\n+        }\n+      ]\n+    }\n+  ]\n+}\n+</pre>\n+</div>\n+<br>\n+But make sure you've added at least two other Roughtime servers to it! Also, consider using our server's IPv4 and/or IPv6 addresses instead of the FQDN to avoid DNSSEC bootstrap issues.\n+</p>\n             </div>\n           </div>\n           <br><br>          "},{"sha":"81a88130f5b3faf4120baaf24dc6d2bb52de77f9","filename":"style.css","status":"modified","additions":4,"deletions":0,"changes":4,"blob_url":"https://github.com/SIDN/TimeNL/blob/462312aec160c3ab34db92a2003aebe4eba86ed1/style.css","raw_url":"https://github.com/SIDN/TimeNL/raw/462312aec160c3ab34db92a2003aebe4eba86ed1/style.css","contents_url":"https://api.github.com/repos/SIDN/TimeNL/contents/style.css?ref=462312aec160c3ab34db92a2003aebe4eba86ed1","patch":"@@ -119,6 +119,10 @@ code {\n     color: yellow;\n }\n \n+pre {\n+    color: yellow;\n+}\n+\n .clocklogo {\n     display: block;\n     color: #fff;"}]}