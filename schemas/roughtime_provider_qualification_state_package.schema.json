{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forecastprovenance.org/schemas/roughtime_provider_qualification_state_package.schema.json",
  "title": "Roughtime Provider Qualification State Package",
  "type": "object",
  "required": [
    "schema_version", "object_type", "provider_id", "as_of_utc", "provider_profile_ref",
    "qualification_decision_ref", "qualification_evidence_manifest_sha256",
    "qualification_verifier_contract_ref", "metadata_review_refs", "requalification_event_refs",
    "qualification_state_report_sha256", "qualification_state", "object_id", "payload_sha256", "content_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "object_type": {"const": "RoughtimeProviderQualificationStatePackage"},
    "provider_id": {"enum": ["roughtime.se", "time.txryan.com", "TimeNL-Roughtime"]},
    "as_of_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "provider_profile_ref": {"$ref": "#/$defs/ref"},
    "qualification_decision_ref": {"$ref": "#/$defs/ref"},
    "qualification_evidence_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "qualification_verifier_contract_ref": {"$ref": "#/$defs/ref"},
    "metadata_review_refs": {"type": "array", "items": {"$ref": "#/$defs/ref"}},
    "requalification_event_refs": {"type": "array", "items": {"$ref": "#/$defs/ref"}},
    "qualification_state_report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "qualification_state": {"enum": [
      "UNREVIEWED", "REHEARSAL_VERIFIED", "QUALIFICATION_REVIEW_READY", "QUALIFICATION_BLOCKED",
      "PRODUCTION_QUALIFIED", "QUALIFICATION_EXPIRED", "REQUALIFICATION_REQUIRED"
    ]},
    "object_id": {"type": "string", "pattern": "^[A-Za-z0-9._:/-]+$"},
    "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false,
  "$defs": {
    "ref": {
      "type": "object",
      "required": ["object_id", "content_sha256"],
      "properties": {
        "object_id": {"type": "string", "pattern": "^[A-Za-z0-9._:/-]+$"},
        "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    }
  }
}
