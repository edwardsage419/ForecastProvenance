{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forecastprovenance.org/schemas/qualification_state_history_snapshot_v1.schema.json",
  "title": "Qualification State History Snapshot V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "object_type",
    "provider_profile_ref",
    "snapshot_sequence",
    "through_as_of_utc",
    "metadata_review_refs",
    "requalification_event_refs",
    "signed_payload_sha256",
    "authority_signature_base64",
    "object_id",
    "payload_sha256",
    "content_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "object_type": {"const": "QualificationStateHistorySnapshot"},
    "provider_profile_ref": {"$ref": "#/$defs/ref"},
    "snapshot_sequence": {"type": "integer", "minimum": 0},
    "predecessor_snapshot_ref": {"$ref": "#/$defs/ref"},
    "through_as_of_utc": {"$ref": "#/$defs/utc"},
    "metadata_review_refs": {"$ref": "#/$defs/ref_array"},
    "requalification_event_refs": {"$ref": "#/$defs/ref_array"},
    "signed_payload_sha256": {"$ref": "#/$defs/sha256"},
    "authority_signature_base64": {"type": "string", "minLength": 4, "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"},
    "object_id": {"type": "string", "pattern": "^qualificationstatehistorysnapshot:v1:[0-9a-f]{12}$"},
    "payload_sha256": {"$ref": "#/$defs/sha256"},
    "content_sha256": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {"properties": {"snapshot_sequence": {"const": 0}}, "required": ["snapshot_sequence"]},
      "then": {"not": {"required": ["predecessor_snapshot_ref"]}},
      "else": {"required": ["predecessor_snapshot_ref"]}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_id", "content_sha256"],
      "properties": {
        "object_id": {"type": "string", "pattern": "^[A-Za-z0-9._:/-]+$"},
        "content_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "ref_array": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/ref"}
    }
  }
}
