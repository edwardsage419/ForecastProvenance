{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forecastprovenance.org/schemas/roughtime_qualification_state_report.schema.json",
  "title": "Derived Roughtime Qualification State Report",
  "type": "object",
  "required": [
    "schema_version", "object_type", "provider_id", "as_of_utc", "state",
    "reason_codes", "active_requalification_event_refs", "report_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "object_type": {"const": "RoughtimeQualificationStateReport"},
    "provider_id": {"enum": ["roughtime.se", "time.txryan.com", "TimeNL-Roughtime"]},
    "as_of_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "state": {
      "enum": [
        "UNREVIEWED",
        "REHEARSAL_VERIFIED",
        "QUALIFICATION_REVIEW_READY",
        "QUALIFICATION_BLOCKED",
        "PRODUCTION_QUALIFIED",
        "QUALIFICATION_EXPIRED",
        "REQUALIFICATION_REQUIRED"
      ]
    },
    "reason_codes": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[A-Za-z0-9._:/-]+$"}
    },
    "decision_ref": {
      "type": "object",
      "required": ["object_id", "content_sha256"],
      "properties": {
        "object_id": {"type": "string", "pattern": "^[A-Za-z0-9._:/-]+$"},
        "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "review_ref": {
      "type": "object",
      "required": ["object_id", "content_sha256"],
      "properties": {
        "object_id": {"type": "string", "pattern": "^[A-Za-z0-9._:/-]+$"},
        "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "latest_metadata_review_ref": {
      "type": "object",
      "required": ["object_id", "content_sha256"],
      "properties": {
        "object_id": {"type": "string", "pattern": "^[A-Za-z0-9._:/-]+$"},
        "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "active_requalification_event_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["object_id", "content_sha256"],
        "properties": {
          "object_id": {"type": "string", "pattern": "^[A-Za-z0-9._:/-]+$"},
          "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
