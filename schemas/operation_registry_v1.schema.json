{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forecastprovenance.org/schemas/operation_registry_v1.schema.json",
  "title": "Operation Registry V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_type", "schema_version", "registry_version", "operations",
    "object_id", "payload_sha256", "content_sha256"
  ],
  "properties": {
    "object_type": {"const": "OperationRegistry"},
    "schema_version": {"const": "1.0"},
    "registry_version": {"$ref": "#/$defs/token"},
    "operations": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"$ref": "#/$defs/operation"}
    },
    "object_id": {"$ref": "#/$defs/object_id"},
    "payload_sha256": {"$ref": "#/$defs/sha256"},
    "content_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "object_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"},
    "token": {"type": "string", "minLength": 1, "pattern": "^[^\\r\\n]+$"},
    "exact_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["object_id", "content_sha256"],
      "properties": {
        "object_id": {"$ref": "#/$defs/object_id"},
        "content_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "role_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["role_id", "object_type", "schema_version"],
      "properties": {
        "role_id": {"$ref": "#/$defs/token"},
        "object_type": {"$ref": "#/$defs/token"},
        "schema_version": {"$ref": "#/$defs/token"},
        "schema_ref": {"$ref": "#/$defs/exact_ref"}
      }
    },
    "role_bindings": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"$ref": "#/$defs/role_binding"}
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id", "owning_component_role", "input_role_bindings",
        "output_role_bindings", "implementation_entrypoint_id",
        "failure_vocabulary_ref", "determinism_requirement"
      ],
      "properties": {
        "operation_id": {"$ref": "#/$defs/token"},
        "owning_component_role": {"$ref": "#/$defs/token"},
        "input_role_bindings": {"$ref": "#/$defs/role_bindings"},
        "output_role_bindings": {"$ref": "#/$defs/role_bindings"},
        "implementation_entrypoint_id": {"$ref": "#/$defs/token"},
        "failure_vocabulary_ref": {"$ref": "#/$defs/exact_ref"},
        "determinism_requirement": {"$ref": "#/$defs/token"}
      }
    }
  }
}
