{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forecastprovenance.org/schemas/validator_contract_v1.schema.json",
  "title": "Validator Contract V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_type", "schema_version", "contract_version", "object_id",
    "payload_sha256", "content_sha256", "authority_scope",
    "component_contract_refs", "operation_registry_ref",
    "implementation_binding_ref", "test_contract_ref", "runtime_profile_ref"
  ],
  "properties": {
    "object_type": {"const": "ValidatorContract"},
    "schema_version": {"const": "1.0"},
    "contract_version": {"$ref": "#/$defs/token"},
    "object_id": {"$ref": "#/$defs/object_id"},
    "payload_sha256": {"$ref": "#/$defs/sha256"},
    "content_sha256": {"$ref": "#/$defs/sha256"},
    "authority_scope": {"$ref": "#/$defs/token"},
    "component_contract_refs": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"$ref": "#/$defs/exact_ref"}
    },
    "operation_registry_ref": {"$ref": "#/$defs/exact_ref"},
    "implementation_binding_ref": {"$ref": "#/$defs/exact_ref"},
    "test_contract_ref": {"$ref": "#/$defs/exact_ref"},
    "runtime_profile_ref": {"$ref": "#/$defs/exact_ref"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "object_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"},
    "token": {"type": "string", "minLength": 1, "pattern": "^[^\\r\\n]+$"},
    "exact_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["object_id", "content_sha256"],
      "properties": {
        "object_id": {"$ref": "#/$defs/object_id"},
        "content_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
