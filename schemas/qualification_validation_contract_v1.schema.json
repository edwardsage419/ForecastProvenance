{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forecastprovenance.org/schemas/qualification_validation_contract_v1.schema.json",
  "title": "Qualification Validation Contract V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "object_type",
    "object_role",
    "qualification_integration_semantics_id",
    "qualification_state_derivation_semantics_id",
    "validator_contract_ref",
    "roughtime_qualification_verifier_contract_ref",
    "accepted_qualification_input_schema_refs",
    "qualification_validation_invocation_schema_ref",
    "dynamic_qualification_state_package_v2_schema_ref",
    "dynamic_qualification_state_package_v2_role_semantics_id",
    "dynamic_qualification_state_package_v2_member_closure_semantics_id",
    "qualification_state_history_snapshot_schema_ref",
    "qualification_state_history_completeness_semantics_id",
    "qualification_state_history_succession_semantics_id",
    "qualification_state_history_snapshot_signature_projection",
    "qualification_state_history_snapshot_signer_semantics_id",
    "state_report_schema_ref",
    "state_report_semantic_hash_projection",
    "qualification_validation_result_schema_ref",
    "invalid_reason_vocabulary_id",
    "invalid_reason_precedence",
    "no_authoritative_result_semantics_id",
    "strict_json_profile",
    "canonicalization_profile",
    "inclusive_cutoff_semantics_id",
    "object_id",
    "payload_sha256",
    "content_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "object_type": {"const": "QualificationValidationContract"},
    "object_role": {"const": "NORMATIVE"},
    "qualification_integration_semantics_id": {"const": "FPP_QUALIFICATION_VALIDATION_INTEGRATION_V1"},
    "qualification_state_derivation_semantics_id": {"const": "FPP_ROUGHTIME_QUALIFICATION_STATE_DERIVATION_V1"},
    "validator_contract_ref": {"$ref": "#/$defs/ref"},
    "roughtime_qualification_verifier_contract_ref": {"$ref": "#/$defs/ref"},
    "accepted_qualification_input_schema_refs": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "uniqueItems": true,
      "prefixItems": [
        {"$ref": "#/$defs/provider_metadata_review"},
        {"$ref": "#/$defs/provider_profile"},
        {"$ref": "#/$defs/qualification_decision"},
        {"$ref": "#/$defs/qualification_evidence_manifest"},
        {"$ref": "#/$defs/qualification_review"},
        {"$ref": "#/$defs/requalification_event"},
        {"$ref": "#/$defs/roughtime_verifier_build_profile"},
        {"$ref": "#/$defs/state_history_snapshot"},
        {"$ref": "#/$defs/state_report"}
      ],
      "items": false
    },
    "qualification_validation_invocation_schema_ref": {"$ref": "#/$defs/ref"},
    "dynamic_qualification_state_package_v2_schema_ref": {"$ref": "#/$defs/ref"},
    "dynamic_qualification_state_package_v2_role_semantics_id": {"const": "FPP_DYNAMIC_QUALIFICATION_STATE_PACKAGE_ROLE_SEMANTICS_V2"},
    "dynamic_qualification_state_package_v2_member_closure_semantics_id": {"const": "FPP_DYNAMIC_QUALIFICATION_STATE_PACKAGE_MEMBER_CLOSURE_V2"},
    "qualification_state_history_snapshot_schema_ref": {"$ref": "#/$defs/ref"},
    "qualification_state_history_completeness_semantics_id": {"const": "FPP_QUALIFICATION_STATE_HISTORY_COMPLETENESS_V1"},
    "qualification_state_history_succession_semantics_id": {"const": "FPP_QUALIFICATION_STATE_HISTORY_SUCCESSION_V1"},
    "qualification_state_history_snapshot_signature_projection": {"const": "FPP_QUALIFICATION_STATE_HISTORY_SNAPSHOT_V1"},
    "qualification_state_history_snapshot_signer_semantics_id": {"const": "FPP_HISTORY_SIGNER_SAME_AS_QUALIFICATION_AUTHORITY_V1"},
    "state_report_schema_ref": {"$ref": "#/$defs/ref"},
    "state_report_semantic_hash_projection": {"const": "SHA256_FPP_JCS_1_EXCLUDING_REPORT_SHA256"},
    "qualification_validation_result_schema_ref": {"$ref": "#/$defs/ref"},
    "invalid_reason_vocabulary_id": {"const": "FPP_QUALIFICATION_VALIDATION_INVALID_REASON_V1"},
    "invalid_reason_precedence": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "uniqueItems": true,
      "prefixItems": [
        {"const": "PACKAGE_STRICT_JSON_INVALID"},
        {"const": "PACKAGE_SCHEMA_INVALID"},
        {"const": "PACKAGE_SEALED_IDENTITY_OR_REFERENCE_INVALID"},
        {"const": "PACKAGE_MEMBER_MANIFEST_INVALID"},
        {"const": "PACKAGE_MEMBER_CLOSURE_INVALID"},
        {"const": "QUALIFICATION_INPUT_SCHEMA_INVALID"},
        {"const": "STATE_REPORT_MEMBER_INVALID"},
        {"const": "HISTORY_SNAPSHOT_AUTHENTICATION_INVALID"},
        {"const": "HISTORY_CUTOFF_INVALID"},
        {"const": "HISTORY_SUCCESSION_INVALID"},
        {"const": "HISTORY_COMPLETENESS_INVALID"},
        {"const": "QUALIFICATION_EVIDENCE_PACKAGE_INVALID"},
        {"const": "QUALIFICATION_AUTHORITY_CHAIN_INVALID"},
        {"const": "QUALIFICATION_STATE_DERIVATION_INVALID"},
        {"const": "STATE_REPORT_SEMANTIC_MISMATCH"}
      ],
      "items": false
    },
    "no_authoritative_result_semantics_id": {"const": "FPP_QUALIFICATION_NO_AUTHORITATIVE_RESULT_V1"},
    "strict_json_profile": {"const": "FPP_STRICT_JSON_1"},
    "canonicalization_profile": {"const": "FPP_JCS_1"},
    "inclusive_cutoff_semantics_id": {"const": "FPP_INCLUSIVE_CUTOFF_V1"},
    "object_id": {"type": "string", "pattern": "^qualificationvalidationcontract:v1:[0-9a-f]{12}$"},
    "payload_sha256": {"$ref": "#/$defs/sha256"},
    "content_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_id", "content_sha256"],
      "properties": {
        "object_id": {"type": "string", "pattern": "^[A-Za-z0-9._:/-]+$"},
        "content_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "role_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "schema_ref"],
      "properties": {
        "role": {"type": "string"},
        "schema_ref": {"$ref": "#/$defs/ref"}
      }
    },
    "provider_metadata_review": {"$ref": "#/$defs/role_ref", "properties": {"role": {"const": "provider_metadata_review"}}},
    "provider_profile": {"$ref": "#/$defs/role_ref", "properties": {"role": {"const": "provider_profile"}}},
    "qualification_decision": {"$ref": "#/$defs/role_ref", "properties": {"role": {"const": "qualification_decision"}}},
    "qualification_evidence_manifest": {"$ref": "#/$defs/role_ref", "properties": {"role": {"const": "qualification_evidence_manifest"}}},
    "qualification_review": {"$ref": "#/$defs/role_ref", "properties": {"role": {"const": "qualification_review"}}},
    "requalification_event": {"$ref": "#/$defs/role_ref", "properties": {"role": {"const": "requalification_event"}}},
    "roughtime_verifier_build_profile": {"$ref": "#/$defs/role_ref", "properties": {"role": {"const": "roughtime_verifier_build_profile"}}},
    "state_history_snapshot": {"$ref": "#/$defs/role_ref", "properties": {"role": {"const": "state_history_snapshot"}}},
    "state_report": {"$ref": "#/$defs/role_ref", "properties": {"role": {"const": "state_report"}}}
  }
}
