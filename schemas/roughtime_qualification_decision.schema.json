{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forecastprovenance.org/schemas/roughtime_qualification_decision.schema.json",
  "title": "Roughtime Production Qualification Decision",
  "type": "object",
  "required": [
    "schema_version", "object_type", "signature_projection", "signed_payload",
    "signed_payload_sha256", "signature_algorithm", "authority_signature_base64",
    "object_id", "payload_sha256", "content_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "object_type": {"const": "RoughtimeQualificationDecision"},
    "signature_projection": {"const": "FPP_ROUGHTIME_QUALIFICATION_DECISION_V1"},
    "signed_payload": {
      "type": "object",
      "required": [
        "criteria_id", "criteria_sha256", "provider_id", "provider_profile_ref",
        "evidence_manifest_sha256", "verifier_build_profile_sha256", "verifier_binary_sha256",
        "independent_review_ref", "metadata_review_ref", "decision_result", "decision_timestamp",
        "authority_id", "authority_public_key_sha256"
      ],
      "properties": {
        "criteria_id": {"const": "FPP_ROUGHTIME_PRODUCTION_QUALIFICATION_V1"},
        "criteria_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "provider_id": {"enum": ["roughtime.se", "time.txryan.com", "TimeNL-Roughtime"]},
        "provider_profile_ref": {
          "type": "object",
          "required": ["object_id", "content_sha256"],
          "properties": {
            "object_id": {"type": "string", "pattern": "^[A-Za-z0-9._:/-]+$"},
            "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          },
          "additionalProperties": false
        },
        "evidence_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "verifier_build_profile_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "verifier_binary_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "independent_review_ref": {
          "type": "object",
          "required": ["object_id", "content_sha256"],
          "properties": {
            "object_id": {"type": "string", "pattern": "^[A-Za-z0-9._:/-]+$"},
            "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          },
          "additionalProperties": false
        },
        "metadata_review_ref": {
          "type": "object",
          "required": ["object_id", "content_sha256"],
          "properties": {
            "object_id": {"type": "string", "pattern": "^[A-Za-z0-9._:/-]+$"},
            "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          },
          "additionalProperties": false
        },
        "decision_result": {"enum": ["PRODUCTION_QUALIFIED", "QUALIFICATION_BLOCKED"]},
        "decision_timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
        "authority_id": {"type": "string", "pattern": "^[A-Za-z0-9._:/-]+$"},
        "authority_public_key_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "signed_payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "signature_algorithm": {"const": "ED25519"},
    "authority_signature_base64": {"type": "string", "minLength": 1},
    "object_id": {"type": "string", "pattern": "^[A-Za-z0-9._:/-]+$"},
    "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
