{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forecastprovenance.org/schemas/implementation_binding_v1.schema.json",
  "title": "Implementation Binding V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_type", "schema_version", "binding_version",
    "source_file_manifest_ref", "package_artifact_ref", "dependency_lock_ref",
    "runtime_profile_ref", "entrypoint_bindings",
    "object_id", "payload_sha256", "content_sha256"
  ],
  "properties": {
    "object_type": {"const": "ImplementationBinding"},
    "schema_version": {"const": "1.0"},
    "binding_version": {"$ref": "#/$defs/token"},
    "source_file_manifest_ref": {"$ref": "#/$defs/exact_ref"},
    "package_artifact_ref": {"$ref": "#/$defs/exact_ref"},
    "dependency_lock_ref": {"$ref": "#/$defs/exact_ref"},
    "runtime_profile_ref": {"$ref": "#/$defs/exact_ref"},
    "entrypoint_bindings": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"$ref": "#/$defs/entrypoint_binding"}
    },
    "object_id": {"$ref": "#/$defs/object_id"},
    "payload_sha256": {"$ref": "#/$defs/sha256"},
    "content_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "object_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"},
    "token": {"type": "string", "minLength": 1, "pattern": "^[^\\r\\n]+$"},
    "exact_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["object_id", "content_sha256"],
      "properties": {
        "object_id": {"$ref": "#/$defs/object_id"},
        "content_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "entrypoint_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_id", "logical_entrypoint_id", "source_unit_ref", "symbol"],
      "properties": {
        "operation_id": {"$ref": "#/$defs/token"},
        "logical_entrypoint_id": {"$ref": "#/$defs/token"},
        "source_unit_ref": {"$ref": "#/$defs/exact_ref"},
        "symbol": {"$ref": "#/$defs/token"}
      }
    }
  }
}
