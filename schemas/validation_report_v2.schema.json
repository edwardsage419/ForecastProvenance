{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forecastprovenance.org/schemas/validation_report_v2.schema.json",
  "title": "ValidationReport V2 with Derived Claims",
  "type": "object",
  "required": [
    "schema_version", "object_type", "validator_contract_ref", "trusted_manifest_ref",
    "candidate_object_ref", "dependency_refs", "result", "checks", "derived_claims",
    "object_id", "payload_sha256", "content_sha256"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "object_type": {"const": "ValidationReport"},
    "validator_contract_ref": {"$ref": "#/$defs/ref"},
    "trusted_manifest_ref": {"$ref": "#/$defs/ref"},
    "manifest_acceptance_ref": {"$ref": "#/$defs/ref"},
    "candidate_object_ref": {"$ref": "#/$defs/ref"},
    "dependency_refs": {"type": "array", "items": {"$ref": "#/$defs/ref"}},
    "result": {"type": "string", "pattern": "^[A-Z0-9_]+$"},
    "checks": {"type": "array"},
    "derived_claims": {
      "type": "array",
      "items": {"$ref": "#/$defs/claim"}
    },
    "object_id": {"type": "string", "pattern": "^[A-Za-z0-9._:/-]+$"},
    "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false,
  "$defs": {
    "ref": {
      "type": "object",
      "required": ["object_id", "content_sha256"],
      "properties": {
        "object_id": {"type": "string", "pattern": "^[A-Za-z0-9._:/-]+$"},
        "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "claim": {
      "type": "object",
      "required": ["claim_type", "subject_ref", "state", "policy_refs", "evidence_refs", "reason_codes"],
      "properties": {
        "claim_type": {"enum": [
          "EXTERNAL_EXISTENCE_BOUND_VERIFIED",
          "DEADLINE_EXISTENCE_VERIFIED",
          "BITCOIN_DURABILITY_VERIFIED",
          "PRE_OUTCOME_DURABILITY_VERIFIED",
          "CONFIRMATORY_PROSPECTIVE_ELIGIBLE"
        ]},
        "subject_ref": {"$ref": "#/$defs/ref"},
        "state": {"enum": ["VERIFIED", "FAILED", "UNRESOLVED", "NOT_APPLICABLE"]},
        "policy_refs": {"type": "array", "items": {"$ref": "#/$defs/ref"}},
        "evidence_refs": {"type": "array", "items": {"$ref": "#/$defs/ref"}},
        "reason_codes": {"type": "array", "items": {"type": "string", "pattern": "^[A-Za-z0-9._:/-]+$"}},
        "verified_upper_bound": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
        "frozen_deadline": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
      },
      "additionalProperties": false
    }
  }
}
