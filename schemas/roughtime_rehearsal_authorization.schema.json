{
  "$defs": {
    "digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "utc": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "type": "string"
    }
  },
  "$id": "https://forecastprovenance.org/schemas/roughtime_rehearsal_authorization.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authorization_scope": {
      "const": "exact_plan_only_no_prospective_use"
    },
    "authorization_sha256": {
      "$ref": "#/$defs/digest"
    },
    "authorized_at_utc": {
      "$ref": "#/$defs/utc"
    },
    "authorized_by": {
      "minLength": 1,
      "type": "string"
    },
    "classification": {
      "const": "NON_FORECAST_REHEARSAL"
    },
    "frozen_deadline_utc": {
      "$ref": "#/$defs/utc"
    },
    "network_authorized": {
      "const": true
    },
    "prospective_eligible": {
      "const": false
    },
    "provider_order": {
      "const": [
        "roughtime.se",
        "time.txryan.com",
        "TimeNL-Roughtime"
      ]
    },
    "rehearsal_plan_sha256": {
      "$ref": "#/$defs/digest"
    },
    "retry_state_snapshot_sha256": {
      "$ref": "#/$defs/digest"
    },
    "schema_version": {
      "const": "1.0"
    },
    "subject_sha256": {
      "$ref": "#/$defs/digest"
    },
    "verifier_build_profile_sha256": {
      "$ref": "#/$defs/digest"
    },
    "verifier_commit": {
      "const": "56b346a16cd7e8317bb0d24f1ec15549cf93a4c9"
    }
  },
  "required": [
    "schema_version",
    "classification",
    "prospective_eligible",
    "network_authorized",
    "rehearsal_plan_sha256",
    "subject_sha256",
    "frozen_deadline_utc",
    "provider_order",
    "verifier_commit",
    "authorized_by",
    "authorized_at_utc",
    "authorization_scope",
    "authorization_sha256",
    "verifier_build_profile_sha256",
    "retry_state_snapshot_sha256"
  ],
  "title": "Roughtime Non-Forecast Rehearsal Authorization",
  "type": "object"
}
