{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forecastprovenance.org/schemas/dynamic_qualification_state_package_v2.schema.json",
  "title": "Dynamic Qualification State Package V2",
  "type": "object",
  "required": [
    "schema_version",
    "object_type",
    "provider_profile_ref",
    "qualification_decision_ref",
    "qualification_state_history_snapshot_ref",
    "state_report_member_sha256",
    "as_of_utc",
    "members",
    "object_id",
    "payload_sha256",
    "content_sha256"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "object_type": {"const": "DynamicQualificationStatePackage"},
    "provider_profile_ref": {"$ref": "#/$defs/ref"},
    "qualification_decision_ref": {"$ref": "#/$defs/ref"},
    "qualification_state_history_snapshot_ref": {"$ref": "#/$defs/ref"},
    "state_report_member_sha256": {"$ref": "#/$defs/sha256"},
    "as_of_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "members": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/member"}
    },
    "object_id": {
      "type": "string",
      "pattern": "^dynamicqualificationstatepackage:v2:[0-9a-f]{12}$"
    },
    "payload_sha256": {"$ref": "#/$defs/sha256"},
    "content_sha256": {"$ref": "#/$defs/sha256"}
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ref": {
      "type": "object",
      "required": ["object_id", "content_sha256"],
      "properties": {
        "object_id": {"type": "string", "pattern": "^[A-Za-z0-9._:/-]+$"},
        "content_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "member": {
      "type": "object",
      "required": ["role", "relative_path", "byte_length", "sha256"],
      "properties": {
        "role": {"type": "string", "pattern": "^[A-Za-z0-9._:/-]+$"},
        "relative_path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*//)(?!.*\\/$)[\\s\\S]+$"
        },
        "byte_length": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    }
  }
}
