{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forecastprovenance.org/schemas/roughtime_requalification_event.schema.json",
  "title": "Roughtime Requalification Event",
  "type": "object",
  "required": [
    "schema_version", "object_type", "provider_id", "provider_profile_ref", "trigger_code",
    "detected_at", "evidence_sha256s", "reason_codes", "object_id", "payload_sha256", "content_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "object_type": {"const": "RoughtimeRequalificationEvent"},
    "provider_id": {"enum": ["roughtime.se", "time.txryan.com", "TimeNL-Roughtime"]},
    "provider_profile_ref": {
      "type": "object",
      "required": ["object_id", "content_sha256"],
      "properties": {
        "object_id": {"type": "string", "pattern": "^[A-Za-z0-9._:/-]+$"},
        "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "trigger_code": {
      "enum": [
        "ROOT_ENDPOINT_PORT_TRANSPORT_CHANGE",
        "WIRE_TYPE_SRV_MERKLE_CHANGE",
        "CONTROL_DOMAIN_CHANGE",
        "STANDARDS_MIGRATION",
        "VERIFIER_CORRECTNESS_BUG",
        "REQUEST_BUILDER_CHANGE",
        "QUALIFICATION_VALIDATOR_OR_SCHEMA_CHANGE",
        "EVIDENCE_CORRUPTION",
        "PRODUCTION_USE_AUTHORIZATION_WITHDRAWN",
        "SERVICE_RETIRED",
        "BLOCKING_COMMON_DEPENDENCY"
      ]
    },
    "detected_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "evidence_sha256s": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "reason_codes": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[A-Za-z0-9._:/-]+$"}
    },
    "object_id": {"type": "string", "pattern": "^[A-Za-z0-9._:/-]+$"},
    "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
