{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forecastprovenance.org/schemas/manifest_acceptance_v2.schema.json",
  "title": "ManifestAcceptance V2",
  "type": "object",
  "required": [
    "schema_version", "object_type", "candidate_manifest_ref", "bootstrap_governance_root_ref",
    "acceptance_rule_ref", "required_validation_report_refs", "authority_ref", "decision",
    "reason_codes", "blocking_finding_refs", "signature_ref", "object_id", "payload_sha256", "content_sha256"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "object_type": {"const": "ManifestAcceptance"},
    "candidate_manifest_ref": {"$ref": "#/$defs/ref"},
    "bootstrap_governance_root_ref": {"$ref": "#/$defs/ref"},
    "acceptance_rule_ref": {"$ref": "#/$defs/ref"},
    "required_validation_report_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/ref"}
    },
    "authority_ref": {"$ref": "#/$defs/ref"},
    "decision": {"enum": ["ACCEPT", "REJECT"]},
    "reason_codes": {"type": "array", "items": {"type": "string", "pattern": "^[A-Za-z0-9._:/-]+$"}},
    "blocking_finding_refs": {"type": "array", "items": {"$ref": "#/$defs/ref"}},
    "signature_ref": {"$ref": "#/$defs/ref"},
    "object_id": {"type": "string", "pattern": "^[A-Za-z0-9._:/-]+$"},
    "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false,
  "$defs": {
    "ref": {
      "type": "object",
      "required": ["object_id", "content_sha256"],
      "properties": {
        "object_id": {"type": "string", "pattern": "^[A-Za-z0-9._:/-]+$"},
        "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    }
  }
}
