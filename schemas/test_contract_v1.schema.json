{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forecastprovenance.org/schemas/test_contract_v1.schema.json",
  "title": "Test Contract V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_type", "schema_version", "test_contract_version", "fixture_refs",
    "command_declarations", "runtime_profile_ref", "operation_coverage",
    "expected_result_vocabulary", "projection_profile_ref",
    "object_id", "payload_sha256", "content_sha256"
  ],
  "properties": {
    "object_type": {"const": "TestContract"},
    "schema_version": {"const": "1.0"},
    "test_contract_version": {"$ref": "#/$defs/token"},
    "fixture_refs": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"$ref": "#/$defs/exact_ref"}
    },
    "command_declarations": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"$ref": "#/$defs/command_declaration"}
    },
    "runtime_profile_ref": {"$ref": "#/$defs/exact_ref"},
    "operation_coverage": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"$ref": "#/$defs/coverage_declaration"}
    },
    "expected_result_vocabulary": {"$ref": "#/$defs/ordered_tokens"},
    "projection_profile_ref": {"$ref": "#/$defs/exact_ref"},
    "object_id": {"$ref": "#/$defs/object_id"},
    "payload_sha256": {"$ref": "#/$defs/sha256"},
    "content_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "object_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"},
    "token": {"type": "string", "minLength": 1, "pattern": "^[^\\r\\n]+$"},
    "exact_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["object_id", "content_sha256"],
      "properties": {
        "object_id": {"$ref": "#/$defs/object_id"},
        "content_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "ordered_tokens": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"$ref": "#/$defs/token"}
    },
    "command_declaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command_id", "argv"],
      "properties": {
        "command_id": {"$ref": "#/$defs/token"},
        "argv": {"$ref": "#/$defs/ordered_tokens"}
      }
    },
    "coverage_declaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_id", "command_ids"],
      "properties": {
        "operation_id": {"$ref": "#/$defs/token"},
        "command_ids": {"$ref": "#/$defs/ordered_tokens"}
      }
    }
  }
}
